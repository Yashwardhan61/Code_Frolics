# Shared Development Database (Neon)
# Copy this file to .env and fill in the values from Neon dashboard.
# Then run the backend with: source .env && mvn spring-boot:run

# Get these from https://console.neon.tech -> your project -> Connection Details
DB_URL=jdbc:postgresql://ep-XXXXX.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USER=your_db_username
DB_PASS=your_db_password
# Firebase (optional, set to "none" to skip)
FIREBASE_SERVICE_ACCOUNT=path/to/your/firebase-key.json
# Mail (Gmail SMTP - use App Password, not your regular password)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Groq AI (Fast Inference)
GROQ_API_KEY=your_groq_api_key_here
